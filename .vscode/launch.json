{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Transformer",
            "type": "debugpy",
            "request": "launch",
            "module": "sidewinder.analysis.transform.transformer",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python Debugger: Executor",
            "type": "debugpy",
            "request": "launch",
            "module": "sidewinder.analysis.symbolic.runtime.__main__",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python Debugger: Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "test/"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}